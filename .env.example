APP_SECRET=
APP_API_URL=http://localhost:3333
APP_WEB_URL=http://localhost:3000

#Mail
MAIL_DRIVER=ethereal
# Remetente dos e-mails (um endereço do seu domínio)
MAIL_FROM=equipe@pontual.com.br

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

#Storage
STORAGE_DRIVE=disk

# Bancos de dados (os padrões são os dos contêineres Docker de desenvolvimento)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=docker
DB_NAME=gostack_gobarber
DB_LOGGING=true
MONGO_URL=mongodb://127.0.0.1:27017/gostack_gobarber

# Login com Google (client id do Google Cloud; vazio = sem o botão)
GOOGLE_CLIENT_ID=

# Várias barbearias numa instalação só. Cada uma abre em
# <identificador>.<BASE_DOMAIN> (no computador: ze.localhost:3000)
BASE_DOMAIN=localhost
# Barbearia de quem abre localhost / 127.0.0.1 (criada ao subir se não existir)
DEFAULT_TENANT=principal
DEFAULT_TENANT_NAME=Minha Barbearia
# Links dos e-mails e do WhatsApp: {host} vira o endereço da barbearia
TENANT_WEB_URL=http://{host}:3000
TENANT_API_URL=http://localhost:3333
# Token do painel do SaaS (rotas /internal); vazio = rotas desligadas
PLATFORM_TOKEN=
# Primeiro administrador da DEFAULT_TENANT (só se ela não tiver ninguém)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
