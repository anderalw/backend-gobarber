# Copie para .env (não versionado) e troque as senhas antes de subir

# Endereço público onde o site abre (sem barra no fim) e a porta no servidor
APP_URL=http://localhost:8080
WEB_PORT=8080

# Fuso da barbearia (a agenda e os lembretes seguem esse horário)
TZ=America/Sao_Paulo

# Segredo dos logins (um texto longo e aleatório; trocar desloga todo mundo)
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Senha do Postgres (só dentro do Docker)
DB_PASS=troque-esta-senha

# Primeiro administrador: criado só quando o banco está vazio
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@minhabarbearia.com.br
ADMIN_PASSWORD=troque-esta-senha

# E-mail: "ethereal" (testes) ou "ses" (Amazon SES)
MAIL_DRIVER=ethereal
# Remetente dos e-mails (vazio = equipe@pontual.com.br)
MAIL_FROM=

# Fotos: "disk" (volume do Docker) ou "s3"
STORAGE_DRIVE=disk

# Login com Google (vazio = sem o botão)
GOOGLE_CLIENT_ID=

# Onde está o front-end para construir o site (pasta ao lado, por padrão)
WEB_CONTEXT=../../front-end-gobarber

# Servidor: usar as imagens publicadas pelo GitHub Actions em vez de construir
# API_IMAGE=ghcr.io/anderalw/pontual-api:latest
# WEB_IMAGE=ghcr.io/anderalw/pontual-web:latest
